{
  "manifest_version": 3,
  "name": "Painel de Atendimento",
  "description": "Catálogo, pedido e mensagens da loja ao lado do WhatsApp Web. Copiar e colar: nunca lê nem envia mensagens.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://royalpodsslz.com/*",
    "https://vaporstoreslz.com/*",
    "https://podsaoluis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "action": {
    "default_title": "Abrir o painel de atendimento",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png"
    }
  },
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  }
}
